{
  "title": "Tighter sign-in checks",
  "category": "security",
  "highlight": true,
  "summary": "Sign-in now asks org admins for a second factor before any session is granted, session cookies slide their expiry on activity, and the legacy token endpoint is gone.",
  "featureUpdates": [
    {
      "featureName": "Authentication",
      "changedFiles": [
        "server/api/auth/login.post.ts",
        "server/utils/session.ts",
        "server/api/auth/token.post.ts"
      ],
      "scenarios": [
        {
          "kind": "new",
          "context": "org admin signing in",
          "action": "sign in with a valid password when two-factor authentication is enforced for admins",
          "outcome": "the user is asked for a second-factor code before any session cookie is set",
          "category": "happy"
        },
        {
          "kind": "changed",
          "matchCode": "HP-1",
          "context": "user on the login page",
          "action": "submit the login form with a registered email and the correct password",
          "outcome": "the user lands on the tasks page, the session cookie is set, and its expiry slides forward on each authenticated request",
          "category": "happy"
        },
        {
          "kind": "fixed",
          "matchCode": "ED-1",
          "context": "user with an active session",
          "action": "open a protected page with an expired session cookie",
          "outcome": "the session is rejected server-side and the user is redirected to the login page",
          "category": "error"
        },
        {
          "kind": "gone",
          "matchCode": "ER-3",
          "context": "user with an active session",
          "action": "open a protected page with a cookie signed by a foreign key",
          "outcome": "the foreign-key cookie rejection was removed together with the legacy token endpoint",
          "category": "error"
        }
      ],
      "connections": [
        { "fromFeature": "Authentication", "toFeature": "Tasks", "type": "authenticates" },
        { "fromFeature": "Authentication", "toFeature": "Tasks", "type": "notifies" },
        { "fromFeature": "Authentication", "toFeature": "Authentication", "type": "triggers" },
        { "fromFeature": "Notifications", "toFeature": "Authentication", "type": "notifies" },
        { "fromFeature": "Authentication", "toFeature": "Tasks", "type": "notifies" }
      ],
      "flow": {
        "nodes": [
          { "id": "start", "kind": "start", "label": "User opens the login page" },
          { "id": "submit", "kind": "step", "label": "Submit email and password", "scenarioCode": "HP-1" },
          { "id": "credentials", "kind": "decision", "label": "Valid credentials?" },
          { "id": "invalid", "kind": "error", "label": "Show 'Invalid email or password'", "scenarioCode": "ER-2" },
          { "id": "locked", "kind": "error", "label": "Account locked" },
          { "id": "protected", "kind": "step", "label": "Open a protected page", "scenarioCode": "ED-1" },
          { "id": "cookie", "kind": "decision", "label": "Session cookie accepted?" },
          { "id": "foreign-cookie", "kind": "error", "label": "Redirect to the login page", "scenarioCode": "ER-3" },
          { "id": "logout", "kind": "step", "label": "Log out", "scenarioCode": "HP-2" },
          { "id": "end", "kind": "end", "label": "Back on the login page" }
        ],
        "edges": [
          { "from": "start", "to": "submit" },
          { "from": "submit", "to": "credentials" },
          { "from": "credentials", "to": "protected", "label": "yes" },
          { "from": "credentials", "to": "invalid", "label": "no" },
          { "from": "invalid", "to": "locked", "label": "too many attempts" },
          { "from": "locked", "to": "end" },
          { "from": "invalid", "to": "submit", "label": "retry" },
          { "from": "protected", "to": "cookie" },
          { "from": "cookie", "to": "logout", "label": "yes" },
          { "from": "cookie", "to": "foreign-cookie", "label": "no" },
          { "from": "foreign-cookie", "to": "end" },
          { "from": "logout", "to": "end" }
        ]
      }
    }
  ]
}
