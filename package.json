{
  "name": "openspecsight",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ],
    "ignoredBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.96",
    "@ai-sdk/openai-compatible": "^3.0.84",
    "@nuxt/ui": "^4.12.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "ai": "^7.0.162",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "nodemailer": "^10.3.1",
    "nuxt": "^4.6.4",
    "octokit": "^5.0.5",
    "tailwindcss": "^4.3.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.151",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
