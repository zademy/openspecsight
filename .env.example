# Database
DATABASE_PATH=./data/app.db

# Public app URL used in emails/links
PUBLIC_APP_URL=http://localhost:3000

# GitHub
# REST API base (point at a local stub for tests, e.g. http://127.0.0.1:9876)
GITHUB_API_BASE=https://api.github.com
# Personal access token for authenticated API calls (never logged or returned)
GITHUB_TOKEN=
# Repository scan limits
GITHUB_MAX_FILES=10000
GITHUB_MAX_TOTAL_BYTES=157286400
# Secret GitHub webhooks sign their requests with (x-hub-signature-256).
# Empty disables the webhook: the endpoint answers 503 until it is set.
GITHUB_WEBHOOK_SECRET=

# LLM
# Provider style: "anthropic" or "openai-compatible"
LLM_API_STYLE=anthropic
LLM_BASE_URL=https://api.minimax.io/anthropic
LLM_API_KEY=
LLM_MODEL=
# When true, the LLM client returns fixture outputs instead of calling the API
LLM_MOCK=false

# Auth (operator login and secret encryption)
SESSION_SECRET=
AUTH_PASSWORD=

# Email (SMTP) — delivery of notifications and digest emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address used for outgoing emails
SMTP_FROM=

# Digests
# Comma-separated recipient list for digest emails
DIGEST_RECIPIENTS=
# When true, the weekly digest job is enabled
DIGEST_WEEKLY_ENABLED=false
